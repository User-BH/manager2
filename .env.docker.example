# ==============================================================================
#  متغیرهای محیطیِ کانتینرها (R41)
# ==============================================================================
#
#  ⚠️ این فایل **جدا از `.env`ِ برنامه است** و جایگزینش نمی‌شود.
#
#  `.env`ِ سرورِ فعلی دست‌نخورده می‌ماند؛ این فقط به `docker compose` گفته
#  می‌شود:
#
#      cp .env.docker.example .env.docker
#      docker compose --env-file .env.docker up -d --build
#
#  `.env.docker` در `.gitignore` است — رمزها هرگز کامیت نمی‌شوند.
# ==============================================================================

APP_ENV=production

# ⚠️ اجباری و بدونِ پیش‌فرض.
#
# عمداً خالی گذاشته شده تا کسی با کلیدِ نمونه بالا نیاید. بسازیدش با:
#     docker compose run --rm app php artisan key:generate --show
APP_KEY=

# باید با پورتی که پایین انتخاب می‌کنید بخواند، وگرنه canonical و لینک‌های
# مطلق (R38) به آدرسِ اشتباه اشاره می‌کنند
APP_URL=http://localhost:8080

PHP_VERSION=8.4

# ─── پورت‌ها ─────────────────────────────────────────────────────────────
#
# همه عمداً غیرِ استاندارد تا با nginx و MySQL و Redisِ خودِ سرور تصادم
# نکنند. اگر همین‌ها هم گرفته باشند، فقط همین اعداد را عوض کنید.
WEB_PORT=8080
DB_PORT_HOST=33061
REDIS_PORT_HOST=63791

# ─── دیتابیس ─────────────────────────────────────────────────────────────
#
# این دیتابیس **مالِ همین کانتینرهاست** و به MySQLِ نصب‌شده‌ی سرور کاری
# ندارد.
DB_DATABASE=sakena
DB_USERNAME=sakena
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────
#
# سقفِ حافظه. چون سیاست `noeviction` است، رسیدن به این سقف خطا می‌دهد نه
# حذفِ خاموشِ کارهای صف — پس عددش را دست‌کم نگیرید.
REDIS_MAXMEMORY=256mb
