# ==============================================================================
#  نمونه‌ی محیطِ آزمایشی (R44)
# ==============================================================================
#
#  ⚠️ تفاوتِ اصلی با محصول عمدی است و دو چیز است:
#
#  ① `LOG_LEVEL=debug` — اینجا جای فهمیدنِ مشکل است، پس لاگِ پرجزئیات
#     مطلوب است. در محصول همان لاگ، بدنه‌ی درخواستِ کاربران را روی دیسک
#     می‌ریزد.
#  ② `PAYMENT_SANDBOX_ENABLED=true` — ⚠️ حیاتی: بدونِ آن، آزمونِ پرداخت
#     روی درگاهِ **واقعی** انجام می‌شود و پولِ واقعی جابه‌جا می‌کند.
#
#  ⚠️ `APP_DEBUG` اینجا هم `false` است. وسوسه‌ی روشن‌کردنش زیاد است، ولی
#  محیطِ آزمایشی معمولاً روی اینترنتِ باز است و همان صفحه‌ی خطا، رمزهای
#  همین محیط را چاپ می‌کند — رمزهایی که اغلب با محصول مشترک‌اند.
#
#  ⚠️ دیتابیسِ آزمایشی باید **جدا** باشد. یک `DB_DATABASE` مشترک یعنی
#  آزمونِ مهاجرت روی داده‌ی واقعیِ ساکنین اجرا شود.
# ==============================================================================
APP_NAME="ساکنا"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.sakena.ir

# اگر سایت پشت CDN یا لود بالانسر است (ArvanCloud، Cloudflare، …) این را
# تنظیم کنید، وگرنه لاراول درخواست را HTTP می‌بیند و آدرس‌ها را با http://
# می‌سازد. مقدار * یعنی به همه‌ی پراکسی‌ها اعتماد کن؛ فقط وقتی امن است که
# سرور مستقیم از اینترنت در دسترس نباشد یا فایروال جلوی آن را گرفته باشد.
TRUSTED_PROXIES=

# --- میزبان‌های مورد اعتماد (R17) ---
# دامنه‌ی APP_URL و همه‌ی زیردامنه‌هایش خودبه‌خود مجازند، پس معمولاً این خالی
# می‌ماند. فقط برای دامنه‌ی اضافی (مثلاً دامنه‌ی قدیمی در دوره‌ی مهاجرت).
# ⚠️ مقدارها الگوی regex‌اند، نه نام ساده:  ^(.+\.)?example\.com$
# بدون این محافظت، هدر Host دستِ فرستنده‌ی درخواست است و آدرس‌های مطلقِ صفحه
# (canonical و og:url) با دامنه‌ی او ساخته می‌شوند.
TRUSTED_HOSTS=

# ⚠️ این متغیر عمداً بی‌اثر است.
#
# `config/app.php` منطقه‌ی زمانی را روی UTC **هاردکد** کرده و این مقدار را
# نمی‌خواند. دلیلش درست است: زمان‌ها باید UTC ذخیره شوند و تبدیل به شمسی فقط
# هنگام نمایش انجام شود (`App\Support\Jalali`). اگر ذخیره با وقتِ محلی بود،
# تغییرِ منطقه‌ی زمانیِ سرور همه‌ی تاریخ‌های گذشته را جابه‌جا می‌کرد.
#
# اینجا نگه داشته شده فقط برای اینکه کسی با دیدنِ نبودش فکر نکند جا افتاده.
# APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# ⚠️ `daily` و نه `single`: با `single` فایلِ laravel.log هرگز نمی‌چرخد و
# تا وقتی دیسک پر شود بزرگ می‌شود — و چون نشست و صف و کش هم روی همین
# سرورند، پرشدنِ دیسک یعنی قطعیِ کامل، نه فقط لاگِ بزرگ (R43).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_ALERT_DAYS=60
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Production: MySQL / MariaDB (manage with phpMyAdmin) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=manager
DB_USERNAME=
DB_PASSWORD=

# --- Local/dev quick start: uncomment to use file-based SQLite instead ---
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ⚠️ صریح نوشته شده، هرچند `config/session.php` در production خودش true
# می‌شود. آن پیش‌فرض به `env('APP_ENV')` وابسته است و اگر روزی کسی نامِ
# محیط را عوض کند (مثلاً `prod`)، بی‌صدا خاموش می‌شود. مقدارِ صریح چنین
# وابستگی‌ای ندارد.
SESSION_SECURE_COOKIE=true

# --- CORS (R16) ---
# فهرستِ دامنه‌های مجاز برای درخواستِ بین‌دامنه‌ای، جداشده با ویرگول.
# خالی = هیچ‌کدام، که پیش‌فرضِ درست است: رابطِ کاربری از همان دامنه سرو می‌شود.
# هرگز `*` ننویسید.
# CORS_ALLOWED_ORIGINS=https://app.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment gateways (configured per-complex in the panel; these are global fallbacks) ---
PAYMENT_DRIVER=fake
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SAMAN_MERCHANT_ID=
SAMAN_TERMINAL_ID=

# --- SMS reminders (optional) ---
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER=

# --- خرید اشتراک پرو (اختیاری) ---
# این درگاه با درگاه هر مجتمع فرق دارد: پول شارژ به حساب مجتمع می‌رود ولی
# پول اشتراک به حساب سرویس‌دهنده. اگر خالی بماند، دکمه‌ی خرید پیام
# «با پشتیبانی تماس بگیرید» نشان می‌دهد و هیچ پرداختی شروع نمی‌شود.
# مقدار «sandbox» برای آزمودن مسیر بدون بانک واقعی است.
# sandbox = تست بدون بانک واقعی | mellat | saman | خالی = فقط خرید با رسید
# درگاه آزمایشی: هر پرداخت را بدون پول واقعی «موفق» می‌کند.
# روی APP_ENV=production خودکار خاموش است؛ فقط برای سرور نمایشی روشنش کنید.
PAYMENT_SANDBOX_ENABLED=true

SUBSCRIPTION_GATEWAY=
SUBSCRIPTION_GATEWAY_TERMINAL=
SUBSCRIPTION_GATEWAY_USERNAME=
SUBSCRIPTION_GATEWAY_PASSWORD=
SUBSCRIPTION_SUPPORT_PHONE="۰۲۱-۹۱۰۰۰۰۰۰"

# حساب مقصدِ واریز اشتراک — در صفحه‌ی «تنظیمات حساب» به مدیر نشان داده
# می‌شود. مقادیر پیش‌فرض ساختگی‌اند و باید عوض شوند.
SUBSCRIPTION_BANK_HOLDER="شرکت ساکنا"
SUBSCRIPTION_BANK_NAME="بانک ملت"
SUBSCRIPTION_BANK_CARD="6104-3372-0000-0000"
SUBSCRIPTION_BANK_IBAN="IR000000000000000000000000"

VITE_APP_NAME="${APP_NAME}"

# ─── پایش و تحلیل (R8) ────────────────────────────────────────────────────
# هیچ‌کدام اجباری نیستند. هر کدام که خالی بماند، آن سرویس کاملاً خاموش است و
# حتی یک بایت هم دانلود نمی‌شود.
#
# همه‌ی این‌ها را می‌توانید به‌جای اینجا، از پنلِ ادمینِ کل ← «پایش و تحلیل»
# وارد کنید. مقدارِ پنل بر مقدارِ اینجا **مقدم** است، و تغییرش نه به دیپلوی
# نیاز دارد و نه به بیلدِ دوباره.

SENTRY_DSN=
SENTRY_CLIENT_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_AUTH_TOKEN=

GA4_MEASUREMENT_ID=
GA4_API_SECRET=

GTM_CONTAINER_ID=

CLARITY_PROJECT_ID=

# ثبتِ خطا در دیتابیسِ خودمان — مستقل از سرویس‌های بالا
ERROR_LOG_ENABLED=true
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_CLIENT_RATE_LIMIT=20

# ── سلامت و هشدار (R43) ──
# رمزِ گزارشِ کاملِ /up. خالی یعنی فقط وضعیتِ یک‌کلمه‌ای برگردد.
HEALTH_SECRET=
# آدرسی که هشدارِ سلامت به آن POST می‌شود. خالی یعنی فقط لاگ و اعلانِ درون‌برنامه‌ای.
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MINUTES=60

# ── مقیاس‌پذیری (R45) ──
PRIVATE_DISK=local
DB_READ_HOST=
RETENTION_CHUNK=1000
