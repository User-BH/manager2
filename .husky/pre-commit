#!/usr/bin/env sh
#
# دروازه‌ی پیش‌کامیت (فنی-۵۲ / DoD-۴۷ و ۴۸).
#
# چیدمان عمدی است: اول کارهای سریع و محدود به فایل‌های staged، بعد بررسی‌های
# سراسریِ کم‌هزینه. هدف این است که این دروازه چند ثانیه بیشتر طول نکشد —
# دروازه‌ی کُند را توسعه‌دهنده با `--no-verify` دور می‌زند و عملاً بی‌اثر می‌شود.
#
# تست‌های بک‌اند و PHPStan عمداً اینجا نیستند (چند ده ثانیه‌اند)؛ آن‌ها در CI
# (R42) و به‌صورت محلی با `composer check` اجرا می‌شوند.

set -e

# ۱) فقط روی فایل‌های staged: قالب‌بندی + لینت (JS/TS) و Pint (PHP)
npx lint-staged

# ۲) بررسی نوع‌ها روی کل پروژه — ارزان است و جلوی شکستنِ تایپ را می‌گیرد
npm run typecheck

# ۳) تست‌های فرانت — سریع‌اند و جریان‌های بحرانی را پوشش می‌دهند
npm test
