includes:
    - vendor/larastan/larastan/extension.neon
    # خطاهای موجود در لحظه‌ی راه‌اندازی، تا دروازه از امروز جلوی خطای *تازه* را بگیرد.
    # این فایل قرار است پله‌پله خالی شود (بیشترش با R9 که کنترلرها را بازسازی می‌کند).
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database
        - routes
        - config

    # سطح ۵ نقطه‌ی شروعِ آگاهانه است، نه سقف.
    # روی کدِ موجود بدون تولیدِ انبوهِ خطا اجرا می‌شود و همان مواردی را می‌گیرد
    # که واقعاً باگ‌زا هستند (تایپِ اشتباهِ آرگومان، متدِ ناموجود، برگشتِ نادرست).
    # قرار است در R9 و R20 پله‌پله بالا برود (۶ → ۸).
    level: 5

    # تست‌ها عمداً بیرون‌اند: در آن‌ها الگوهایی هست (فراخوانیِ عمدیِ نادرست برای
    # سنجشِ خطا) که تحلیلِ استاتیک را بی‌دلیل شلوغ می‌کند.
    excludePaths:
        - tests/*
        - vendor/*
        - storage/*
        - bootstrap/cache/*
